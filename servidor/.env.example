# Copie para .env e preencha. O .env nunca vai para o git.

PORT=3000
NODE_ENV=production

# Base pública, usada para montar o link que vai ao Anjo pelo WhatsApp.
# Sem barra no fim. Se ficar vazio, o servidor deduz do cabeçalho da requisição.
PUBLIC_BASE_URL=https://seu-dominio.exemplo


# ---------------------------------------------------------------------------
# Banco — um usuário por módulo, de propósito
#
# `mer_app` não tem permissão nenhuma sobre as tabelas de alerta, e
# `mer_alerts` não tem nenhuma sobre a tabela da pesquisa. Quem invadir um
# lado não lê o outro. Se um dia isto virar um usuário só, a separação morre.
# ---------------------------------------------------------------------------

DB_HOST=localhost
# Só preencha se o banco não estiver na 3306 (container Docker, por exemplo).
DB_PORT=3306
DB_NAME=mulheres_em_risco

# Módulo survey — formulários e dashboard
DB_SURVEY_USER=mer_app
DB_SURVEY_PASSWORD=

# Módulo alert — o sistema do produto
DB_ALERTS_USER=mer_alerts
DB_ALERTS_PASSWORD=

# Se um destes ficar vazio, o servidor sobe do mesmo jeito e só aquele módulo
# responde 503. Os outros continuam no ar.


# ---------------------------------------------------------------------------
# Acesso — dois papéis, porque são duas exposições diferentes
#
# A pesquisadora lê respostas anônimas de campo. A operadora vê o nome, o
# telefone e a localização em tempo real de uma mulher durante uma agressão.
# Não é a mesma responsabilidade e não deve ser a mesma senha.
#
# Mínimo de 12 caracteres — o servidor recusa subir com menos.
# Gere cada uma com:  openssl rand -base64 24
# ---------------------------------------------------------------------------

RESEARCHER_USER=pesquisa
RESEARCHER_PASSWORD=

OPERATOR_USER=central
OPERATOR_PASSWORD=

# Compatibilidade: se RESEARCHER_PASSWORD ou OPERATOR_PASSWORD faltarem, o
# servidor cai para ADMIN_USER/ADMIN_PASSWORD e avisa no log. Serve para não
# derrubar uma instalação existente na hora de migrar — não é para ficar assim.
#ADMIN_USER=admin
#ADMIN_PASSWORD=


# ---------------------------------------------------------------------------
# Demonstração
# ---------------------------------------------------------------------------

# Libera /simulador (a página que finge ser o aplicativo) e /app (download do
# APK). Só abre para a operadora logada. Deixe 0 em produção.
DEMO_MODE=0

# Caminho do APK servido em /app quando DEMO_MODE=1.
APK_PATH=
