# Copie para .env e preencha. O .env nunca vai para o git.

PORT=3000
NODE_ENV=production

# Base publica, usada para montar o link que vai ao Anjo pelo WhatsApp.
# Sem barra no fim. Se ficar vazio, o servidor deduz do cabecalho da requisicao.
PUBLIC_BASE_URL=https://seu-dominio.exemplo

DB_HOST=localhost
# So preencha se o banco nao estiver na 3306 (container Docker, por exemplo).
DB_PORT=3306
DB_USER=mer_app
DB_PASSWORD=a_senha_que_voce_definiu_no_schema_sql
DB_NAME=mulheres_em_risco

# Segundo usuario de banco, so para o subsistema de alertas (schema_alerts.sql).
# Nao tem permissao nenhuma sobre a tabela `respostas` — e proposital.
# Se ficar vazio, o servidor sobe do mesmo jeito e as rotas de alerta
# respondem 503; a pesquisa de campo continua no ar.
DB_ALERTS_USER=mer_alerts
DB_ALERTS_PASSWORD=

# Acesso ao painel em /admin e à central em /central
ADMIN_USER=admin
# Mínimo de 12 caracteres — o servidor recusa subir com menos.
# Gere uma com:  openssl rand -base64 24
ADMIN_PASSWORD=

# Libera /simulador, a página que finge ser o aplicativo.
# Serve para testar o fluxo inteiro sem depender do celular. Deixe 0 em produção.
DEMO_MODE=0

# Caminho do APK servido em /app durante a demo (só com DEMO_MODE=1).
APK_PATH=
