<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS é o padrão e continua obrigatório para qualquer host da internet.
  A exceção por domínio existe só para desenvolver contra a máquina local
  na LAN. Nunca usar android:usesCleartextTraffic="true" global: dá o mesmo
  trabalho e abre o app inteiro.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.50</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
