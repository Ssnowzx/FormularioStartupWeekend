<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada sai do aparelho por backup nem por transferência de aparelho.
  Sem isso, a palavra secreta e o token vazariam para o backup do Google
  de uma conta que, no modelo de ameaça, o agressor conhece.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
